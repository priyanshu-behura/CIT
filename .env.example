# Backend Configuration
PROJECT_NAME="Campus Scheduling and Venue Management Platform for Chilika Institute of Technology (CIT)"
API_V1_STR="/api/v1"
PORT=8000
HOST="127.0.0.1"

# Dataset Source of Truth
# By default, points to official cit_public.json inside the starter pack
DATASET_PATH="../CrunchWeek_StarterPack (1)/CrunchWeek_StarterPack/data/cit_public.json"

# CORS Allowed Origins (Comma-separated or list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Configuration
VITE_API_URL="http://127.0.0.1:8000"

