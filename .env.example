# ==============================================================================
# Campus Scheduling and Venue Management Platform for Chilika Institute of Technology (CIT)
# Environment Configuration Template
# ==============================================================================

# Backend Configuration
PROJECT_NAME="Campus Scheduling and Venue Management Platform for Chilika Institute of Technology (CIT)"
API_V1_STR="/api/v1"
PORT=8000
HOST="127.0.0.1"

# Environment Mode ("development", "test", or "production")
# In production, CIT_SECRET_KEY is mandatory and the application will fail to start if unset.
APP_ENV="development"

# JWT Authentication Secret Key (Required for production deployments)
# Generate a secure 256-bit+ random secret using:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
CIT_SECRET_KEY="replace-with-a-secure-random-secret-key-for-production"

# Google Gemini LLM API Configuration
# Optional for deterministic baseline; required for full generative AI campus assistant.
# Obtain a replacement key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL="gemini-2.5-flash"

# Dataset Source of Truth
# By default, points to official cit_public.json inside the starter pack
DATASET_PATH="../CrunchWeek_StarterPack (1)/CrunchWeek_StarterPack/data/cit_public.json"

# CORS Allowed Origins (Comma-separated or list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Configuration
VITE_API_URL="http://127.0.0.1:8000"
